---
const BUSINESS = {
	name: "HB Rodrigues Solutions",
	tagline: "Full-stack software, from first prototype to production.",
	email: "herinson@hbrodrigues.com",
	linkedin: "https://www.linkedin.com/in/herinson",
	personalSite: "https://herodrigues.dev/",
};

const canonicalURL = new URL("/business/", Astro.site);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: BUSINESS.name,
	description: BUSINESS.tagline,
	url: canonicalURL.href,
	telephone: "+556140422876",
	email: BUSINESS.email,
	founder: {
		"@type": "Person",
		name: "Herinson Rodrigues",
		url: new URL(BUSINESS.personalSite, Astro.site).href,
		sameAs: [BUSINESS.linkedin],
	},
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="theme-color" content="#2F5D3A" />

		<title>{BUSINESS.name}</title>
		<meta name="description" content={BUSINESS.tagline} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={BUSINESS.name} />
		<meta property="og:description" content={BUSINESS.tagline} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Source+Sans+3:wght@400;600&display=swap"
		/>

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<main class="table">
			<div class="card">
				<div class="identity">
					<div class="monogram" aria-hidden="true">HB</div>
					<h1>{BUSINESS.name}</h1>
					<p class="tagline">{BUSINESS.tagline}</p>
				</div>

				<ul class="contacts">
					<li>
						<a href={`mailto:${BUSINESS.email}`}>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
							{BUSINESS.email}
						</a>
					</li>
					<li>
						<a href={BUSINESS.linkedin} rel="me">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10.5V16"></path><path d="M8 7.5v.01"></path><path d="M12 16v-5.5"></path><path d="M12 13a2.5 2.5 0 0 1 5 0v3"></path></svg>
							LinkedIn · @herinson
						</a>
					</li>
					<li>
						<a href={BUSINESS.personalSite}>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3a14 14 0 0 1 0 18"></path><path d="M12 3a14 14 0 0 0 0 18"></path></svg>
							About Herinson Rodrigues
						</a>
					</li>
				</ul>
			</div>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--accent: #2f5d3a;
		--ink: #1f2a1f;
		--ink-muted: #3f4d3f;
		--rule: #dde4d8;
		--card: #ffffff;
	}

	body {
		margin: 0;
		background: var(--accent);
	}
</style>

<style>
	.table {
		font-family: "Source Sans 3", system-ui, sans-serif;
		color: var(--ink);
		min-height: 100vh;
		min-height: 100dvh;
		box-sizing: border-box;
		padding: 48px 20px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.card {
		width: 100%;
		max-width: 800px;
		background: var(--card);
		border-radius: 20px;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25);
		padding: 48px;
		box-sizing: border-box;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
		align-items: center;
	}

	.identity {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.monogram {
		width: 56px;
		height: 56px;
		border-radius: 999px;
		border: 2px solid var(--accent);
		color: var(--accent);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: "Bricolage Grotesque", sans-serif;
		font-weight: 800;
		font-size: 20px;
		letter-spacing: -0.02em;
	}

	h1 {
		margin: 0;
		font-family: "Bricolage Grotesque", sans-serif;
		font-size: 38px;
		line-height: 1.1;
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.tagline {
		margin: 0;
		font-size: 18px;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.contacts {
		list-style: none;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
		font-size: 17px;
		border-left: 1px solid var(--rule);
		padding: 0 0 0 32px;
	}

	.contacts a {
		color: var(--ink);
		text-decoration: none;
		min-height: 44px;
		display: flex;
		align-items: center;
		gap: 10px;
		overflow-wrap: anywhere;
	}

	.contacts a:hover {
		color: var(--accent);
	}

	.contacts svg {
		flex-shrink: 0;
	}

	/* Below the width where both columns fit, stack them. */
	@media (max-width: 735px) {
		.card {
			grid-template-columns: 1fr;
			gap: 28px;
			padding: 32px 24px;
		}

		h1 {
			font-size: 32px;
		}

		.contacts {
			border-left: 0;
			border-top: 1px solid var(--rule);
			padding: 20px 0 0;
		}
	}
</style>
