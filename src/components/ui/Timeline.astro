---
export interface TimelineItemData {
    title: string;
    period: string;
    subtitle: string;
    location?: string;
    description?: string;
    highlights?: string[];
    thesis?: string;
}

interface Props {
    items: TimelineItemData[];
}

const { items } = Astro.props;
---

<div class="timeline flex flex-col">
    {
        items.map((item) => (
            <div class="timeline-item flex gap-4 sm:gap-8">
                <div class="timeline-marker flex flex-col items-center shrink-0">
                    <div class="dot w-3 h-3 rounded-full bg-accent mt-2 z-10" />
                    <div class="timeline-line flex-1 w-[2px] bg-border my-2" />
                </div>
                <div class="timeline-content pb-8 flex-1 min-w-0">
                    <div class="entry-header flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-x-4 mb-1">
                        <h3 class="title-md transition-colors duration-200">
                            {item.title}
                        </h3>
                        <span class="body-sm font-semibold opacity-75 sm:whitespace-nowrap">
                            {item.period}
                        </span>
                    </div>
                    <div class="body font-semibold opacity-90">
                        {item.subtitle}
                        {item.location && (
                            <span class="font-normal opacity-75"> · {item.location}</span>
                        )}
                    </div>
                    {item.description && (
                        <div class="body mt-2">
                            {item.description}
                        </div>
                    )}
                    {item.thesis && (
                        <div class="body italic mt-2 opacity-80">
                            Thesis: {item.thesis}
                        </div>
                    )}
                    {item.highlights && item.highlights.length > 0 && (
                        <ul class="body mt-2 list-disc pl-5 space-y-1">
                            {item.highlights.map((h) => <li>{h}</li>)}
                        </ul>
                    )}
                </div>
            </div>
        ))
    }
</div>
